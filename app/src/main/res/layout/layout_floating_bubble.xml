<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- 1. Circular Floating Action Button (Gol Button) -->
    <FrameLayout
        android:id="@+id/fl_bubble_circle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_circle_connected"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_bubble_power_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Toggle Proxy"
            android:src="@drawable/ic_power_button" />

        <!-- Tiny Pulse Beacon Indicator in Circle Corner -->
        <View
            android:id="@+id/v_status_beacon"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:background="#00E676" />
    </FrameLayout>

    <!-- 2. Small Proxy Details Pill Below Circle (Tar Niche Choto Kore Proxy Details) -->
    <LinearLayout
        android:id="@+id/ll_bubble_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_floating_details_pill"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- Top Details Row: Country Flag + Code + City -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_country_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🌐 US New York"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="ON"
                android:textColor="#00E676"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Details Row: IP, Divider, Timer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_proxy_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0.0.0"
                android:textColor="#90A4AE"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="•"
                android:textColor="#546E7A"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_bubble_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#00E676"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
